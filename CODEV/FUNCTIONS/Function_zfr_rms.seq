!***************************************************************************************
! Purpose:      Define a macro function Function_zfr_rms to define zernike function
!               (based on terms 4 to 11)
!
! Syntax:       in Function_zfr_rms
!
! Usage:        @ZFR_rms
!
!****************************************************************************************

FCT @ZFR_rms(NUM ^z(1..32))

^temp == (1/4)*^z(2)**2+(1/4)*^z(3)**2+(1/3)*^z(4)**2+(1/6)*^z(5)**2+(1/6)*^z(6)**2+(1/8)*^z(7)**2+(1/8)*^z(8)**2+(1/5)*^z(9)**2
^temp == ^temp+(1/8)*^z(10)**2+(1/8)*^z(11)**2
^temp == ^temp+(1/10)*^z(12)**2+(1/10)*^z(13)**2+(1/12)*^z(14)**2+(1/12)*^z(15)**2+(1/7)*^z(16)**2
^temp == ^temp+(1/10)*^z(17)**2+(1/10)*^z(18)**2+(1/12)*^z(19)**2+(1/12)*^z(20)**2
^temp == ^temp+(1/14)*^z(21)**2+(1/14)*^z(22)**2+(1/16)*^z(23)**2+(1/16)*^z(24)**2
^temp == ^temp+(1/9)*^z(25)**2+(1/12)*^z(26)**2+(1/12)*^z(27)**2
^temp == ^temp+(1/14)*^z(28)**2+(1/14)*^z(29)**2+(1/16)*^z(30)**2+(1/16)*^z(31)**2+(1/18)*^z(32)**2 

END FCT ^temp
